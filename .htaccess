# Defense in depth for local/legacy Apache entry points only.
# Production must serve public/ with sources and secrets outside the webroot.
# These rules are not a substitute for a correctly configured document root.
Options -Indexes

# These file protections do not depend on URL rewriting. Include compressed
# backups/dumps (for example .sql.gz and .bak.zip), not ordinary public assets.
<FilesMatch "(?i)(?:^(?:\.env(?:\..*)?|\.ht(?:access|passwd)(?:\..*)?|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.[^/]+)$|\.(?:sql|sqlite3?|db|log|env|ini|bak|backup|orig|old|save|swp|swo|pem|key|p12|pfx|sh|py|pl|cgi|phar|phtml)(?:\.(?:tar|gz|bz2|xz|zip|7z|tgz))*$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REMOTE_ADDR} =127.0.0.1 [OR]
    RewriteCond %{REMOTE_ADDR} =::1
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{REQUEST_URI} ^/HOMECONFORT/(?:public/)?index\.php$ [NC]
    RewriteRule ^(?:public/)?index\.php$ http://127.0.0.1:8080/fr [R=302,L]

    # The bundled Apache PHP 8.2 cannot boot Laravel 13. Local browser entry
    # points use the compatible PHP 8.5 runtime; private paths remain denied.
    RewriteCond %{REMOTE_ADDR} =127.0.0.1 [OR]
    RewriteCond %{REMOTE_ADDR} =::1
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{REQUEST_URI} ^/HOMECONFORT(?:/public)?(?:/(?:fr|en|de|admin)(?:/|$)|/?$) [NC]
    RewriteRule ^(?:public/)?(.*)$ http://127.0.0.1:8080/$1 [R=302,L,NE]

    # Keep the existing local XAMPP entry point for the /HOMYA folder only.
    RewriteCond %{REMOTE_ADDR} =127.0.0.1 [OR]
    RewriteCond %{REMOTE_ADDR} =::1
    RewriteCond %{REQUEST_URI} ^/HOMYA/?$ [NC]
    RewriteRule ^$ http://127.0.0.1:8080/fr [R=302,L]

    # Hostinger and Laravel need access to ACME challenge files at the root.
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Deter tools that identify themselves as offline website mirrors, including
    # static-asset requests. User-Agent can be changed: this is not bot verification.
    RewriteCond %{HTTP_USER_AGENT} (?:Win[[:space:]_-]*)?HTTrack|Web[[:space:]_-]*Copier|Web[[:space:]_-]*ZIP|Offline[[:space:]_-]*Explorer|Teleport[[:space:]_-]*Pro|Site[[:space:]_-]*Sucker [NC]
    RewriteRule ^ - [F,L]

    # Deny private source/configuration paths before routing.
    RewriteRule "(^|/)\.(?!well-known/acme-challenge/)" - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|vendor|node_modules|scripts|tests|output|docs)(?:/|$) - [F,L,NC]
    RewriteRule ^storage/(?:app|framework|logs)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.[^/]+)$ - [F,L,NC]
    RewriteRule "\.(?:sql|log|env|ini|bak|backup|orig|sh|py|pl|cgi|phar|phtml)(?:/|$)" - [F,L,NC]

    # An internal rewrite sets REDIRECT_STATUS. Skip the root rewrite on that
    # pass so public/.htaccess can serve assets and route Laravel requests.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^$ public/ [L]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>
