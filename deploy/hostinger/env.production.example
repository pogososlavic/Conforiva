# Template only: create the real .env privately on Hostinger, outside public_html.
APP_NAME="HOME CONFORT"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# REQUIRED: same confirmed hostname in all three values below.
HOMYA_PRODUCTION_HOST=
APP_URL=
HOMYA_PUBLIC_URL=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# File catalogue requires the separately delivered catalogue data and media.
# SQL source is intentionally protected for XAMPP only; do not disable its guard.
HOMYA_CATALOGUE_SOURCE=files
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=""
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
HOMYA_COMMERCE_DB_HOST=localhost
HOMYA_COMMERCE_DB_PORT=3306
HOMYA_COMMERCE_DB_SOCKET=""
HOMYA_COMMERCE_DB_DATABASE=
HOMYA_COMMERCE_DB_USERNAME=
HOMYA_COMMERCE_DB_PASSWORD=

# Configure and test SMTP before enabling commerce or inviting real messages.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="HOME CONFORT"
HOMYA_CONTACT_EMAIL=
HOMYA_CONTACT_PHONE=

# Closed until schema, stock, legal information and commercial flows are validated.
HOMYA_INVENTORY_ENABLED=false
HOMYA_CHECKOUT_ENABLED=false
HOMYA_DEFERRED_ORDERS_ENABLED=false
HOMYA_COMMERCE_LEGAL_READY=false
HOMYA_BANK_TRANSFER_ENABLED=false
HOMYA_ADMIN_REMOTE_ENABLED=false
HOMYA_ADMIN_MANAGEMENT_ENABLED=false
HOMYA_ADMIN_USERNAME=
HOMYA_ADMIN_PASSWORD_HASH=

HOMYA_SEO_INDEXING_ENABLED=false
HOMYA_MERCHANT_FEED_ENABLED=false
HOMYA_GA4_ENABLED=false
HOMYA_PAID_PURCHASE_MEASUREMENT_ENABLED=false
HOMYA_STOREFRONT_PROTECTION_MODE=observe
HOMYA_STOREFRONT_CLIENT_IP_VERIFIED=false
